# Application Configuration
MAX_PLAYLIST_SIZE=50
MAX_DOWNLOADS_PER_HOUR=10
MAX_DOWNLOADS_PER_DAY=50
MAX_FILE_SIZE_MB=250
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT=300
# Download YouTube livestream archives from their beginning when supported.
DOWNLOAD_LIVESTREAM_FROM_START=true
PORT=5000
BITRATE=192
JOB_TTL_SECONDS=3600
# Directory for finished downloads (Docker mounts a persistent volume at /app/downloads)
DOWNLOAD_DIR=/app/downloads

# Rate Limiting
# Off by default everywhere, including local Docker. Enable explicitly on
# online deployments only (render.yaml sets RATE_LIMIT_ENABLED=true).
RATE_LIMIT_ENABLED=false
# Applies to endpoints without an explicit limit, including job status
# polling during long downloads. Raised so polling is not throttled to 30/hr.
DEFAULT_RATE_LIMIT=60 per minute, 3600 per hour
RATE_LIMIT_STORAGE=memory
# If using Redis:
# RATE_LIMIT_STORAGE=redis
# REDIS_URL=redis://localhost:6379

# Proxy Configuration
USE_X_FORWARDED_FOR=false
# TRUSTED_PROXIES=proxy1,proxy2

# YouTube bot-check workarounds (for datacenter hosts like Render)
# Path to a Netscape-format cookies.txt exported from a logged-in browser
# session. Mount the file into the container and point this at it.
# COOKIE_FILE=/cookies/cookies.txt
# Residential proxy to escape datacenter-IP flagging.
# YOUTUBE_PROXY=http://user:pass@residential-proxy:port
# Optional browser User-Agent matching the browser that produced the cookies.
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...
# Alternative to mounting cookies.txt: base64-encoded Netscape cookie content.
# YOUTUBE_COOKIES_B64=...
# Cookie policy: disabled, when_needed (recommended), or all.
YOUTUBE_COOKIE_BEHAVIOR=when_needed
# Player clients yt-dlp tries, in order (default: android,ios).
# YOUTUBE_PLAYER_CLIENTS=android,ios,tv

# /api/health probes this stable public video and caches the result.
# HEALTH_CHECK_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw
# HEALTH_CHECK_TTL_SECONDS=60